# Copy to .env (never commit .env)
# Wallet that pays for and creates the launch: path to a keypair .json file,
# or its secret key (base58 or [1,2,...])
LAUNCH_KEYPAIR=
# Mainnet RPC (Helius/QuickNode/Triton recommended)
RPC_URL=https://api.mainnet-beta.solana.com
# Pinata JWT, used to pin the token image + metadata JSON to IPFS
PINATA_JWT=
